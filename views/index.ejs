<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Photo Notes</title>
  <link rel="stylesheet" href="<%= staticBaseUrl %>/static/css/style.css">
</head>
<body>
  <header>
    <div class="header-content">
      <h1>📸 Photo Notes</h1>
      <a href="/new" class="btn btn-primary">+ New Note</a>
    </div>
  </header>

  <main class="container">
    <% if (notes.length === 0) { %>
      <div class="empty-state">
        <p>No notes yet. Create your first one!</p>
      </div>
    <% } %>

    <div class="notes-grid">
      <% notes.forEach(note => { %>
        <div class="note-card">
          <% if (note.image_display_url) { %>
            <div class="note-image">
              <img src="<%= note.image_display_url %>" alt="<%= note.title %>" loading="lazy">
            </div>
          <% } %>
          <div class="note-body">
            <h2><%= note.title %></h2>
            <p><%= note.content %></p>
            <div class="note-footer">
              <span class="note-date"><%= new Date(note.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
              <form action="/notes/<%= note.id %>/delete" method="POST" class="delete-form">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this note?')">Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </main>

  <script src="<%= staticBaseUrl %>/static/js/app.js"></script>
</body>
</html>
